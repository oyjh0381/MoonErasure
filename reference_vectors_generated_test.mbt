  let input : Array[Bytes?] = [
    None,
    Some(b"\xc9"),
    Some(b"\xcb"),
    Some(b"\xcc"),
    Some(b"\x2b"),
  ]
  assert_eq(try! codec.reconstruct(input), expected)
  assert_eq(try! codec.reconstruct_selected(input, [0]), [b"\xc7"])
  let changes : Array[@moonerasure.DataShardUpdate] = [
    { index: 0, old_data: b"\xc7", new_data: b"\x4d", },
    { index: 3, old_data: b"\xcc", new_data: b"\x74", },
  ]
  let old_parity = [b"\x2b"]
  assert_eq(try! codec.update_parity(old_parity, changes), [b"\x51"])
}

