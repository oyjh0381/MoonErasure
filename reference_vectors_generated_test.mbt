    b"\xa1", b"\xa2", b"\xa4", b"\xa6", b"\xa8", b"\xa9", b"\xab",
  ]
  let expected = [
    b"\x92", b"\x93", b"\x95", b"\x97", b"\x98", b"\x9a", b"\x9c", b"\x9d", b"\x9f",
    b"\xa1", b"\xa2", b"\xa4", b"\xa6", b"\xa8", b"\xa9", b"\xab", b"\xe4", b"\x0c",
    b"\x1f", b"\xc4", b"\xe1", b"\x5d", b"\xfb", b"\x95",
  ]
  assert_eq(try! codec.encode_all(data), expected)
  let input : Array[Bytes?] = [
    None,
    Some(b"\x93"),
    Some(b"\x95"),
    Some(b"\x97"),
    Some(b"\x98"),
    Some(b"\x9a"),
    Some(b"\x9c"),
    Some(b"\x9d"),
    Some(b"\x9f"),
    Some(b"\xa1"),
    Some(b"\xa2"),
    Some(b"\xa4"),
    Some(b"\xa6"),
    Some(b"\xa8"),
    Some(b"\xa9"),
    Some(b"\xab"),
    Some(b"\xe4"),
    Some(b"\x0c"),
    Some(b"\x1f"),
    Some(b"\xc4"),
    Some(b"\xe1"),
    Some(b"\x5d"),
    Some(b"\xfb"),
    None,
  ]
  assert_eq(try! codec.reconstruct(input), expected)
  assert_eq(try! codec.reconstruct_selected(input, [23, 0]), [b"\x95", b"\x92"])
  let changes : Array[@moonerasure.DataShardUpdate] = [
    { index: 0, old_data: b"\x92", new_data: b"\x79", },
    { index: 15, old_data: b"\xab", new_data: b"\x3c", },
  ]
  let old_parity = [
    b"\xe4", b"\x0c", b"\x1f", b"\xc4", b"\xe1", b"\x5d", b"\xfb", b"\x95",
  ]
  assert_eq(try! codec.update_parity(old_parity, changes), [
    b"\xb1", b"\x48", b"\x85", b"\x75", b"\x92", b"\x47", b"\x10", b"\x85",
