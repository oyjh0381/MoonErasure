///|
test "Go v1.14.2 parity recovery and update vector 0: 1+1/1" {
  let codec = try! @moonerasure.Codec::new(1, 1)
  let data = [b"\xa6"]
  let expected = [b"\xa6", b"\xa6"]
  assert_eq(try! codec.encode_all(data), expected)
  let input : Array[Bytes?] = [None, Some(b"\xa6")]
  assert_eq(try! codec.reconstruct(input), expected)
  assert_eq(try! codec.reconstruct_selected(input, [0]), [b"\xa6"])
  let changes : Array[@moonerasure.DataShardUpdate] = [
    { index: 0, old_data: b"\xa6", new_data: b"\x42", },
  ]
  let old_parity = [b"\xa6"]
  assert_eq(try! codec.update_parity(old_parity, changes), [b"\x42"])
}

