test "Go v1.14.2 parity recovery and update vector 20: 10+4/1" {
  let codec = try! @moonerasure.Codec::new(10, 4)
  let data = [
    b"\x27", b"\x29", b"\x2b", b"\x2d", b"\x2e", b"\x30", b"\x32", b"\x33", b"\x35",
    b"\x37",
  ]
  let expected = [
    b"\x27", b"\x29", b"\x2b", b"\x2d", b"\x2e", b"\x30", b"\x32", b"\x33", b"\x35",
    b"\x37", b"\x98", b"\x8d", b"\xdf", b"\x06",
  ]
  assert_eq(try! codec.encode_all(data), expected)
  let input : Array[Bytes?] = [
    None,
    Some(b"\x29"),
    Some(b"\x2b"),
    Some(b"\x2d"),
    Some(b"\x2e"),
    Some(b"\x30"),
    Some(b"\x32"),
    Some(b"\x33"),
    Some(b"\x35"),
    Some(b"\x37"),
    Some(b"\x98"),
    Some(b"\x8d"),
    Some(b"\xdf"),
    None,
  ]
  assert_eq(try! codec.reconstruct(input), expected)
  assert_eq(try! codec.reconstruct_selected(input, [13, 0]), [b"\x06", b"\x27"])
  let changes : Array[@moonerasure.DataShardUpdate] = [
    { index: 0, old_data: b"\x27", new_data: b"\x63", },
    { index: 9, old_data: b"\x37", new_data: b"\xd8", },
  ]
  let old_parity = [b"\x98", b"\x8d", b"\xdf", b"\x06"]
  assert_eq(try! codec.update_parity(old_parity, changes), [
    b"\xa2", b"\xad", b"\x7e", b"\xae",
  ])
}

